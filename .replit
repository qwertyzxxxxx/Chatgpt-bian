modules = ["python-3.11", "bash"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["python_database:1.0.0"]

[nix]
channel = "stable-25_05"

[workflows]

[deployment]
deploymentTarget = "vm"
run = ["python", "run_server.py"]
build = ["uv", "sync", "--no-editable"]

[userenv]

[userenv.shared]

[[ports]]
localPort = 8080
externalPort = 80
