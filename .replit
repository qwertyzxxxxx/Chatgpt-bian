modules = ["python-3.11", "bash", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["python_database:1.0.0"]

[nix]
channel = "stable-25_05"

[workflows]

[deployment]
deploymentTarget = "vm"
run = [".venv/bin/python", "run_server.py"]
build = ["bash", "-c", "pip install psycopg2-binary && uv venv && uv sync --no-editable"]

[userenv]

[userenv.shared]
LIVE_TRADING_ENABLED = "true"
ORDER_NOTIONAL_USDT = "2000"
MAX_PENDING_ORDERS = "10"
MAX_OPEN_POSITIONS = "5"
LIVE_SYNC_INTERVAL_MIN = "15"
LIVE_REPORT_INTERVAL_MIN = "60"

[[ports]]
localPort = 8080
externalPort = 80
