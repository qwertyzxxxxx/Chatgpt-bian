modules = ["python-3.11", "bash", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["python_database:1.0.0"]

[nix]
channel = "stable-25_05"

[workflows]

[deployment]
deploymentTarget = "vm"
run = ["python", "run_server.py"]
build = ["bash", "-c", "pip install psycopg2-binary -r requirements.txt"]

[userenv]

[userenv.shared]
LIVE_TRADING_ENABLED = "true"
ORDER_NOTIONAL_USDT = "2000"
MAX_PENDING_ORDERS = "10"
MAX_OPEN_POSITIONS = "5"
LIVE_REPORT_INTERVAL_MIN = "60"
LIVE_SYNC_INTERVAL_MIN = "3"
ENABLE_HOTLIST_REVERSAL = "true"
ENABLE_V662 = "true"
ENABLE_V663 = "true"
ENABLE_V664 = "true"

[[ports]]
localPort = 8080
externalPort = 80
