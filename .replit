modules = ["python-3.11", "bash"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "us-stock-hunter"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python run_server.py"
waitForPort = 8080

[[workflows.workflow]]
name = "us-stock-hunter"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "test -f /home/runner/us-stock-hunter/main.py && cd /home/runner/us-stock-hunter && python3 main.py schedule || echo '[us-stock-hunter] main.py not found — awaiting redeploy'"

[deployment]
deploymentTarget = "vm"
run = ["python", "run_server.py"]
build = ["uv", "sync", "--no-editable"]

[userenv]

[userenv.shared]

[[ports]]
localPort = 8080
externalPort = 80
