# Binance AI Trader V1 does not require secrets, API keys, account credentials,
# or order permissions. The application does not automatically load this file.
# Keep runtime settings explicit in the CLI commands documented in docs/runbook.md.

# Informational defaults used by the documented shell commands:
PYTHONPATH=src
MARKET_DATABASE=data/market_data.db
UNIVERSE_CONFIG=config/universe.json
SECTORS_CONFIG=config/sectors.json

# Optional Telegram notifications. Binance market data remains public-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
