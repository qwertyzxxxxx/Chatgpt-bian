# Binance AI Trader — environment variable reference.
# The application does not auto-load this file.
# Set all variables as Replit Secrets or via the deployment env panel.

# ── Core ─────────────────────────────────────────────────────────────────────
PYTHONPATH=src
MARKET_DATABASE=data/market_data.db
UNIVERSE_CONFIG=config/universe.json
SECTORS_CONFIG=config/sectors.json

# ── Telegram ─────────────────────────────────────────────────────────────────
# Configure both or leave both unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/db

# ── FMP (Financial Modeling Prep) ─────────────────────────────────────────────
FMP_API_KEY=

# ── V3 Live Mirror 实盘模块 ────────────────────────────────────────────────────
# 默认关闭 (false)。设为 true 并填写 API Key 才会真实下单。
LIVE_TRADING_ENABLED=false

# Binance USD-M Futures API (需要 Futures 交易权限，不需提现权限)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 每笔名义仓位 (USDT)
# 示例：1000U 名义 + 10x 杠杆 → 保证金约 100U
ORDER_NOTIONAL_USDT=1000

# 实盘风控上限
MAX_PENDING_ORDERS=10
MAX_OPEN_POSITIONS=5

# 定时任务间隔（分钟）
LIVE_SYNC_INTERVAL_MIN=15
LIVE_REPORT_INTERVAL_MIN=60
